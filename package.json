{
  "name": "@statens-pensjonskasse/skatt-inntekt-api",
  "version": "1.6.2",
  "_README_": "BEWARE: version is updated by api-updater.mjs to match version of API",
  "files": [
    "skatt-inntekt-api.json",
    "skatt-inntekt-api.yaml",
    "README.md"
  ],
  "scripts": {
    "lint": "redocly lint skatt-inntekt-api.yaml && redocly lint skatt-inntekt-api.json",
    "make-yaml": "redocly bundle skatt-inntekt-api.json -o skatt-inntekt-api.yaml",
    "renovate": "node scripts/api-renovate.mjs",
    "update-spec": "node scripts/api-updater.mjs  && npm run make-yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statens-pensjonskasse/skatt-inntekt-api.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
