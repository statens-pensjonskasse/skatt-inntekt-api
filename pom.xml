<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- BEWARE: NOT A MAVEN PROJECT, pom is used and manipulated by scripts -->
    <groupId>no.spk.ios<!--API-GROUP--></groupId>
    <artifactId>skatt-inntekt-api<!--API-NAME--></artifactId>
    <version>1.7.0.1<!--APIVERSION--></version>
    <packaging>pom</packaging>

    <scm>
        <url>https://github.com/statens-pensjonskasse/${project.artifactId}</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/statens-pensjonskasse/${project.artifactId}</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>attach-openapi</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>skatt-inntekt-api.yaml<!--API-YAML--></file>
                                    <type>yaml</type>
                                    <classifier>openapi</classifier>
                                </artifact>
                                <artifact>
                                    <file>skatt-inntekt-api.json<!--API-JSON--></file>
                                    <type>json</type>
                                    <classifier>openapi</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
